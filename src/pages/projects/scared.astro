---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../utils/withBase';
import ArcDiagram from '../../components/charts/ArcDiagram';
import ScatterPlot from '../../components/charts/ScatterPlot';
import BarChart from '../../components/charts/BarChart';

// Sample SCARED symptom data (placeholder — swap in real data when ready)
const nodes = [
  { id: 's1',  label: 'Worries',       subscale: 'GAD' },
  { id: 's2',  label: 'Nervous',       subscale: 'GAD' },
  { id: 's3',  label: 'Perfectionist', subscale: 'GAD' },
  { id: 's4',  label: 'Nightmares',    subscale: 'SAD' },
  { id: 's5',  label: 'Clingy',        subscale: 'SAD' },
  { id: 's6',  label: 'Misses home',   subscale: 'SAD' },
  { id: 's7',  label: 'Shy',           subscale: 'Social' },
  { id: 's8',  label: 'Embarrassed',   subscale: 'Social' },
  { id: 's9',  label: 'Heart races',   subscale: 'Somatic' },
  { id: 's10', label: 'Dizzy',         subscale: 'Somatic' },
  { id: 's11', label: 'Avoids school', subscale: 'School' },
  { id: 's12', label: 'School fear',   subscale: 'School' },
];

const links = [
  { source: 's1', target: 's2', weight: 0.82 },
  { source: 's1', target: 's3', weight: 0.65 },
  { source: 's2', target: 's3', weight: 0.71 },
  { source: 's4', target: 's5', weight: 0.78 },
  { source: 's4', target: 's6', weight: 0.60 },
  { source: 's5', target: 's6', weight: 0.74 },
  { source: 's7', target: 's8', weight: 0.88 },
  { source: 's9', target: 's10', weight: 0.69 },
  { source: 's11', target: 's12', weight: 0.85 },
  { source: 's1', target: 's9', weight: 0.42 },
  { source: 's2', target: 's7', weight: 0.38 },
  { source: 's7', target: 's11', weight: 0.55 },
  { source: 's3', target: 's8', weight: 0.33 },
  { source: 's5', target: 's11', weight: 0.47 },
];

const scatterData = [
  { symptom: 'Worries',       child: 2.1, parent: 1.8, subscale: 'GAD' },
  { symptom: 'Nervous',       child: 1.9, parent: 2.3, subscale: 'GAD' },
  { symptom: 'Perfectionist', child: 2.4, parent: 1.5, subscale: 'GAD' },
  { symptom: 'Nightmares',    child: 0.8, parent: 1.2, subscale: 'SAD' },
  { symptom: 'Clingy',        child: 1.1, parent: 1.7, subscale: 'SAD' },
  { symptom: 'Misses home',   child: 1.5, parent: 1.3, subscale: 'SAD' },
  { symptom: 'Shy',           child: 2.0, parent: 1.6, subscale: 'Social' },
  { symptom: 'Embarrassed',   child: 1.8, parent: 1.4, subscale: 'Social' },
  { symptom: 'Heart races',   child: 1.2, parent: 0.9, subscale: 'Somatic' },
  { symptom: 'Dizzy',         child: 0.7, parent: 0.5, subscale: 'Somatic' },
  { symptom: 'Avoids school', child: 1.4, parent: 1.9, subscale: 'School' },
  { symptom: 'School fear',   child: 1.6, parent: 2.1, subscale: 'School' },
];

const barData = [
  { subscale: 'GAD',     reporter: 'Child',  medianScore: 2.1 },
  { subscale: 'GAD',     reporter: 'Parent', medianScore: 1.9 },
  { subscale: 'SAD',     reporter: 'Child',  medianScore: 1.1 },
  { subscale: 'SAD',     reporter: 'Parent', medianScore: 1.4 },
  { subscale: 'Social',  reporter: 'Child',  medianScore: 1.9 },
  { subscale: 'Social',  reporter: 'Parent', medianScore: 1.5 },
  { subscale: 'Somatic', reporter: 'Child',  medianScore: 1.0 },
  { subscale: 'Somatic', reporter: 'Parent', medianScore: 0.7 },
  { subscale: 'School',  reporter: 'Child',  medianScore: 1.5 },
  { subscale: 'School',  reporter: 'Parent', medianScore: 2.0 },
];
---

<BaseLayout
  title="SCARED — Child–Parent Symptom Network Analysis"
  description="Network-based modeling to understand child–parent discrepancies in anxiety symptoms."
>
  <article>
    <header class="mb-8">
      <h1 class="text-2xl font-bold mb-2">SCARED — Child–Parent Symptom Network Analysis</h1>
      <p class="text-zinc-500 dark:text-zinc-400">
        Network-based modeling to understand child–parent discrepancies in anxiety symptoms.
      </p>
      <div class="flex gap-3 mt-4 text-sm">
        <a href="https://github.com/kaleoyster/scared-network" target="_blank" rel="noopener noreferrer"
           class="text-blue-600 dark:text-blue-400 hover:underline">GitHub →</a>
        <a href="https://kaleoyster.github.io/scared/" target="_blank" rel="noopener noreferrer"
           class="text-blue-600 dark:text-blue-400 hover:underline">Live Analysis →</a>
      </div>
    </header>

    <div class="prose dark:prose-invert mb-12">
      <p>
        Traditional psychological scoring methods collapse symptoms into a single number, losing the
        <em>relationships</em> between symptoms and the <em>discrepancies</em> between child and parent reports.
        This project uses network analysis to treat each symptom as a node, revealing central, influential, and
        bridging symptoms across 31 child–parent dyads.
      </p>
    </div>

    <!-- Arc Diagram -->
    <section class="mb-12">
      <h2 class="text-lg font-semibold mb-1">Symptom Network (Arc Diagram)</h2>
      <p class="text-sm text-zinc-500 dark:text-zinc-400 mb-4">
        Nodes are symptoms, colored by subscale. Arc thickness reflects correlation strength.
      </p>
      <div class="overflow-x-auto">
        <ArcDiagram client:load nodes={nodes} links={links} width={680} />
      </div>
    </section>

    <!-- Scatter Plot -->
    <section class="mb-12">
      <h2 class="text-lg font-semibold mb-1">Child vs. Parent Scores</h2>
      <p class="text-sm text-zinc-500 dark:text-zinc-400 mb-4">
        Each point is a symptom. Points above the dashed line indicate parents rated higher than children.
      </p>
      <ScatterPlot client:load data={scatterData} width={460} />
    </section>

    <!-- Bar Chart -->
    <section class="mb-12">
      <h2 class="text-lg font-semibold mb-1">Median Score by Subscale and Reporter</h2>
      <p class="text-sm text-zinc-500 dark:text-zinc-400 mb-4">
        Comparing child and parent median scores across anxiety subscales.
      </p>
      <BarChart client:load data={barData} width={500} />
    </section>

    <!-- Network metrics table -->
    <section class="mb-12">
      <h2 class="text-lg font-semibold mb-4">Network Metrics</h2>
      <div class="prose dark:prose-invert">
        <table>
          <thead>
            <tr>
              <th>Metric</th>
              <th>Meaning</th>
            </tr>
          </thead>
          <tbody>
            <tr><td><strong>Degree centrality</strong></td><td>How many symptoms a given symptom is directly connected to.</td></tr>
            <tr><td><strong>Betweenness</strong></td><td>How often a symptom lies on the shortest path between other symptoms.</td></tr>
            <tr><td><strong>Closeness</strong></td><td>How near a symptom is—on average—to all other symptoms.</td></tr>
            <tr><td><strong>Eigenvector</strong></td><td>Influence: a symptom connected to other highly influential symptoms.</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <div class="mt-10">
      <a href={withBase('/#projects')} class="text-sm text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white transition-colors">
        ← Back to Projects
      </a>
    </div>
  </article>
</BaseLayout>
