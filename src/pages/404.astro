---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../utils/withBase';
---

<BaseLayout title="Page Not Found">
  <div class="text-center py-20">
    <p class="text-6xl font-bold text-zinc-200 dark:text-zinc-700 mb-4">404</p>
    <h1 class="text-xl font-semibold mb-2">Page not found</h1>
    <p class="text-zinc-500 dark:text-zinc-400 mb-8">The page you're looking for doesn't exist.</p>
    <a href={withBase('/')} class="px-4 py-2 bg-zinc-900 dark:bg-white text-white dark:text-zinc-900 rounded-md text-sm font-medium hover:opacity-80 transition-opacity">
      Go home
    </a>
  </div>
</BaseLayout>
