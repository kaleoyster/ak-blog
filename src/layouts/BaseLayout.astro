---
import SEO from '../components/SEO.astro';
import { getCollection } from 'astro:content';
import { publicationsCount } from '../data/publications';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title = 'Akshay Kale', description, image } = Astro.props;

// Per-page social card generated by /og/[...route].ts (key mirrors the path).
const rawPath = Astro.url.pathname.replace(/\/+$/, '').replace(/^\//, '');
const ogKey = rawPath === '' || rawPath === '404' ? 'index' : rawPath;
const ogImage = image ?? `/og/${ogKey}.png`;

// Projects are searchable in ⌘K; nav badges reflect actual counts.
const projectsCol = await getCollection('projects');
const publishedProjectsCount = projectsCol.filter((p) => p.data.status !== 'coming-soon').length;
// + SCARED and CoRA, which live outside the content collection.
const projectsCount = publishedProjectsCount + 2;

const nav = [
  { href: '/#summary', label: 'Summary' },
  { href: '/experience', label: 'Experience' },
  { href: '/projects', label: 'Projects', count: projectsCount },
  { href: '/publications', label: 'Publications', count: publicationsCount },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

// Search index for the ⌘K command palette.
const pubTitles = [
  { title: 'Model-Cart: A Machine Learning Meta-Framework with Explainability and Human-in-the-Loop', href: 'https://link.springer.com/chapter/10.1007/978-3-031-89063-5_27' },
  { title: 'A Comparative Assessment of Bridge Deck Wearing Surfaces', href: 'https://www.mdpi.com/2076-3417/13/19/10883' },
  { title: 'New Measure to Understand and Compare Bridge Conditions (Time-Series)', href: 'https://ascelibrary.org/doi/full/10.1061/%28ASCE%29IS.1943-555X.0000633' },
  { title: 'Toward Interactive Visualizations for Explaining Machine Learning Models', href: 'http://idl.iscram.org/files/ramsey/2023/2570_Ramsey_etal2023.pdf' },
  { title: 'A Comparative Framework for Evaluating Machine Learning Model Explanations', href: 'https://www.proquest.com/openview/cc973a983790196d6446abebaf9d85e3/1?pq-origsite=gscholar&cbl=18750&diss=y' },
];

type CmdItem = { title: string; kind: string; href: string; keywords?: string; external?: boolean };
const cmdItems: CmdItem[] = [
  { title: 'Summary', kind: 'Section', href: '/#summary' },
  { title: 'Experience', kind: 'Page', href: '/experience' },
  { title: 'Projects', kind: 'Section', href: '/#projects' },
  { title: 'Publications', kind: 'Section', href: '/#publications' },
  { title: 'All projects', kind: 'Page', href: '/projects' },
  { title: 'All publications', kind: 'Page', href: '/publications' },
  { title: 'Download résumé (PDF)', kind: 'File', href: '/pdf/Akshay_Kale_Resume.pdf', external: true },
  { title: 'Download CV (PDF)', kind: 'File', href: '/pdf/Akshay_Kale_CV.pdf', external: true },
  { title: 'SCARED — Symptom Network Analysis', kind: 'Project', href: '/projects/scared', keywords: 'visualization networks anxiety' },
  ...projectsCol.map((p) => ({ title: p.data.title, kind: 'Project', href: `/projects/${p.id}`, keywords: (p.data.tags || []).join(' ') })),
  { title: 'CoRA', kind: 'Project', href: 'https://github.com/kaleoyster', keywords: 'visualization d3 network graph', external: true },
  { title: 'Baseline Difference Score', kind: 'Publication', href: '/research/baseline-difference-score', keywords: 'time-series metric research' },
  ...pubTitles.map((p) => ({ title: p.title, kind: 'Publication', href: p.href, external: true })),
];
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Resume fonts: Lato (body) + Raleway (name) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,300;0,400;0,700;1,300;1,400&family=Raleway:wght@500;600&display=swap" rel="stylesheet" />

    <SEO title={title} description={description} image={ogImage} />

    <!-- Dark mode: read preference before paint to avoid flash -->
    <script is:inline>
      (function () {
        const stored = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (stored === 'dark' || (!stored && prefersDark)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </head>

  <body class="bg-white dark:bg-zinc-900 text-zinc-800 dark:text-zinc-200 min-h-screen flex flex-col font-sans antialiased">

    <header class="sticky top-0 z-50 border-b border-zinc-200/70 dark:border-zinc-700/70 bg-white/80 dark:bg-zinc-900/80 backdrop-blur">
      <div class="max-w-3xl mx-auto px-6 h-14 flex items-center justify-center relative">
        <nav class="hidden md:flex flex-nowrap items-center gap-x-4 gap-y-1 text-sm">
          {nav.map(({ href, label, count }) => {
            const isAnchor = href.startsWith('/#');
            const isActive = !isAnchor && currentPath === href;
            return (
              <a
                href={href}
                data-nav={isAnchor ? href.replace('/#', '') : ''}
                class:list={['nav-link relative text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white transition-colors', { 'is-active': isActive }]}
              >
                {label}
                {count ? <span class="nav-badge">{count}</span> : null}
              </a>
            );
          })}
        </nav>
        <div class="absolute inset-y-0 right-6 flex items-center gap-1">
          <button
            id="cmdk-open"
            aria-label="Search (⌘K)"
            class="shrink-0 flex items-center gap-1.5 p-1.5 rounded-md text-zinc-400 hover:text-zinc-700 dark:hover:text-zinc-200 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M17 11a6 6 0 11-12 0 6 6 0 0112 0z" />
            </svg>
            <kbd class="hidden md:inline text-[0.6rem] font-sans px-1.5 py-0.5 rounded border border-zinc-300 dark:border-zinc-600 text-zinc-400">/</kbd>
          </button>
          <button
            id="theme-toggle"
            aria-label="Toggle dark mode"
            class="shrink-0 p-1.5 rounded-md text-zinc-400 hover:text-zinc-700 dark:hover:text-zinc-200 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors"
          >
            <svg id="icon-sun" xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 hidden dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707M17.657 17.657l-.707-.707M6.343 6.343l-.707-.707M12 8a4 4 0 100 8 4 4 0 000-8z" />
            </svg>
            <svg id="icon-moon" xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 block dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
            </svg>
          </button>
        </div>
      </div>
      <div id="scroll-progress" aria-hidden="true"></div>
    </header>

    <!-- ⌘K command palette -->
    <div id="cmdk" class="cmdk-overlay" hidden>
      <div class="cmdk-panel" role="dialog" aria-modal="true" aria-label="Search">
        <div class="cmdk-input-row">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-zinc-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M17 11a6 6 0 11-12 0 6 6 0 0112 0z" /></svg>
          <input id="cmdk-input" class="cmdk-input" type="text" placeholder="Search projects, papers, posts, sections…" autocomplete="off" spellcheck="false" />
        </div>
        <ul id="cmdk-results" class="cmdk-results"></ul>
        <div class="cmdk-hint"><span>↑↓ navigate</span><span>↵ open</span><span>esc close</span></div>
      </div>
    </div>
    <script type="application/json" id="cmdk-data" set:html={JSON.stringify(cmdItems)} is:inline></script>

    <main class="flex-1 max-w-3xl mx-auto w-full px-6 py-12">
      <slot />
    </main>

    <footer class="border-t border-zinc-200 dark:border-zinc-700">
      <div class="max-w-3xl mx-auto px-6 py-8 flex flex-col items-center gap-4">
        <div class="flex gap-5 text-zinc-400 dark:text-zinc-500">
          <a href="mailto:akshaykale4@icloud.com" class="hover:text-zinc-700 dark:hover:text-zinc-300 transition-colors" title="Email">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
          </a>
          <a href="https://github.com/kaleoyster" target="_blank" rel="noopener noreferrer" class="hover:text-zinc-700 dark:hover:text-zinc-300 transition-colors" title="GitHub">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.387-1.333-1.756-1.333-1.756-1.09-.745.083-.73.083-.73 1.205.085 1.84 1.237 1.84 1.237 1.07 1.834 2.807 1.304 3.492.997.108-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23A11.51 11.51 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.29-1.552 3.297-1.23 3.297-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222 0 1.606-.015 2.898-.015 3.293 0 .32.216.694.825.576C20.565 21.796 24 17.298 24 12c0-6.63-5.37-12-12-12z"/></svg>
          </a>
          <a href="https://www.researchgate.net/profile/Akshay-Kale-2" target="_blank" rel="noopener noreferrer" class="hover:text-zinc-700 dark:hover:text-zinc-300 transition-colors" title="ResearchGate">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M19.586 0H4.414A4.414 4.414 0 000 4.414v15.172A4.414 4.414 0 004.414 24h15.172A4.414 4.414 0 0024 19.586V4.414A4.414 4.414 0 0019.586 0zM11.45 17.995c-2.828 0-5.145-2.233-5.145-5.148 0-2.915 2.317-5.148 5.145-5.148 1.52 0 2.78.55 3.73 1.493l-1.07 1.07c-.65-.623-1.535-1.01-2.66-1.01-2.122 0-3.666 1.664-3.666 3.595 0 1.93 1.544 3.594 3.666 3.594 1.617 0 2.744-.826 3.074-2.07h-3.074v-1.452h4.637c.052.273.08.554.08.843 0 2.707-1.814 4.333-4.717 4.333zm6.8-.242h-1.487V7.636h1.487v10.117z"/></svg>
          </a>
          <a href="https://orcid.org/0000-0001-6191-7996" target="_blank" rel="noopener noreferrer" class="hover:text-zinc-700 dark:hover:text-zinc-300 transition-colors" title="ORCID">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.372 0 0 5.372 0 12s5.372 12 12 12 12-5.372 12-12S18.628 0 12 0zM7.369 4.378c.525 0 .947.431.947.947s-.422.947-.947.947a.95.95 0 01-.947-.947c0-.525.422-.947.947-.947zm-.722 3.038h1.444v10.041H6.647V7.416zm3.562 0h3.9c3.712 0 5.344 2.653 5.344 5.025 0 2.578-2.016 5.016-5.325 5.016h-3.919V7.416zm1.444 1.303v7.444h2.297c3.272 0 3.872-2.484 3.872-3.722 0-2.016-1.284-3.722-3.862-3.722h-2.307z"/></svg>
          </a>
        </div>
        <p class="text-xs text-zinc-400 dark:text-zinc-600">&copy; {new Date().getFullYear()} Akshay Kale</p>
      </div>
    </footer>

    <!-- Dark mode toggle logic -->
    <script>
      function applyTheme() {
        const btn = document.getElementById('theme-toggle');
        if (!btn) return;
        btn.addEventListener('click', () => {
          const isDark = document.documentElement.classList.toggle('dark');
          localStorage.setItem('theme', isDark ? 'dark' : 'light');
        });
      }
      applyTheme();
      document.addEventListener('astro:after-swap', applyTheme);
    </script>

    <!-- Scroll-spy: highlight the nav link for the section in view -->
    <script>
      function initScrollSpy() {
        const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.nav-link'));
        if (!links.length) return;
        const sections = links
          .map((l) => document.getElementById(l.dataset.nav || ''))
          .filter((el): el is HTMLElement => !!el);
        if (!sections.length) return;

        const setActive = (id: string) => {
          links.forEach((l) => l.classList.toggle('is-active', l.dataset.nav === id));
        };

        const observer = new IntersectionObserver(
          (entries) => {
            const visible = entries
              .filter((e) => e.isIntersecting)
              .sort((a, b) => b.intersectionRatio - a.intersectionRatio);
            if (visible[0]) setActive(visible[0].target.id);
          },
          { rootMargin: '-45% 0px -50% 0px', threshold: [0, 0.25, 0.5, 1] }
        );
        sections.forEach((s) => observer.observe(s));
      }
      initScrollSpy();
      document.addEventListener('astro:after-swap', initScrollSpy);
    </script>

    <!-- ⌘K command palette -->
    <script>
      function initCmdK() {
        const overlay = document.getElementById('cmdk');
        const input = document.getElementById('cmdk-input') as HTMLInputElement | null;
        const results = document.getElementById('cmdk-results');
        const dataEl = document.getElementById('cmdk-data');
        const openBtn = document.getElementById('cmdk-open');
        if (!overlay || !input || !results || !dataEl) return;
        if ((overlay as any)._wired) return;
        (overlay as any)._wired = true;

        type Item = { title: string; kind: string; href: string; keywords?: string; external?: boolean };
        const items: Item[] = JSON.parse(dataEl.textContent || '[]');
        let active = 0;
        let current: Item[] = [];

        const filter = (q: string): Item[] => {
          const s = q.trim().toLowerCase();
          if (!s) return items;
          return items
            .map((it) => {
              const hay = (it.title + ' ' + it.kind + ' ' + (it.keywords || '')).toLowerCase();
              const idx = hay.indexOf(s);
              return { it, score: idx === -1 ? 9999 : idx };
            })
            .filter((r) => r.score < 9999)
            .sort((a, b) => a.score - b.score)
            .map((r) => r.it);
        };

        const render = () => {
          results.innerHTML = '';
          current.forEach((it, i) => {
            const li = document.createElement('li');
            li.className = 'cmdk-item' + (i === active ? ' is-active' : '');
            li.innerHTML = `<span class="cmdk-title"></span><span class="cmdk-kind"></span>`;
            (li.querySelector('.cmdk-title') as HTMLElement).textContent = it.title;
            (li.querySelector('.cmdk-kind') as HTMLElement).textContent = it.kind;
            li.addEventListener('click', () => go(it));
            li.addEventListener('mousemove', () => { active = i; paintActive(); });
            results.appendChild(li);
          });
        };
        const paintActive = () => {
          Array.from(results.children).forEach((el, i) => el.classList.toggle('is-active', i === active));
          const el = results.children[active] as HTMLElement | undefined;
          el?.scrollIntoView({ block: 'nearest' });
        };
        const go = (it: Item) => {
          close();
          if (it.external) window.open(it.href, '_blank', 'noopener');
          else window.location.href = it.href;
        };
        const open = () => {
          overlay.hidden = false;
          input.value = '';
          current = filter('');
          active = 0;
          render();
          setTimeout(() => input.focus(), 0);
        };
        const close = () => { overlay.hidden = true; };
        const toggle = () => (overlay.hidden ? open() : close());

        input.addEventListener('input', () => { current = filter(input.value); active = 0; render(); });
        input.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowDown') { e.preventDefault(); active = Math.min(active + 1, current.length - 1); paintActive(); }
          else if (e.key === 'ArrowUp') { e.preventDefault(); active = Math.max(active - 1, 0); paintActive(); }
          else if (e.key === 'Enter') { e.preventDefault(); if (current[active]) go(current[active]); }
        });
        overlay.addEventListener('click', (e) => { if (e.target === overlay) close(); });
        openBtn?.addEventListener('click', open);
        document.addEventListener('keydown', (e) => {
          if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); toggle(); }
          else if (e.key === '/' && overlay.hidden && !['INPUT','TEXTAREA','SELECT'].includes((e.target as HTMLElement).tagName)) { e.preventDefault(); open(); }
          else if (e.key === 'Escape' && !overlay.hidden) close();
        });
      }
      initCmdK();
      document.addEventListener('astro:after-swap', initCmdK);
    </script>

    <!-- Cursor spotlight on listing-page cards -->
    <script>
      function initCardSpotlight() {
        document.querySelectorAll<HTMLElement>('.card-live').forEach((el) => {
          el.addEventListener('pointermove', (e) => {
            const r = el.getBoundingClientRect();
            el.style.setProperty('--mx', `${((e.clientX - r.left) / r.width) * 100}%`);
            el.style.setProperty('--my', `${((e.clientY - r.top) / r.height) * 100}%`);
          });
        });
      }
      initCardSpotlight();
      document.addEventListener('astro:after-swap', initCardSpotlight);
    </script>

    <!-- Scroll-progress bar under the navbar -->
    <script>
      function initScrollProgress() {
        const bar = document.getElementById('scroll-progress');
        if (!bar) return;
        const update = () => {
          const max = document.documentElement.scrollHeight - window.innerHeight;
          const p = max > 0 ? Math.min(1, window.scrollY / max) : 0;
          bar.style.transform = `scaleX(${p})`;
        };
        update();
        window.addEventListener('scroll', update, { passive: true });
        window.addEventListener('resize', update);
      }
      initScrollProgress();
      document.addEventListener('astro:after-swap', initScrollProgress);
    </script>

    <!-- Vercel Analytics -->
    <script>
      import { inject } from '@vercel/analytics';
      inject();
    </script>

  </body>
</html>

<style is:global>
  @import "../styles/global.css";

  body {
    font-family: 'Lato', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, sans-serif;
  }

  .font-display {
    font-family: 'Raleway', 'Lato', sans-serif;
  }

  .prose h2 { @apply text-xl font-semibold mt-8 mb-3; }
  .prose h3 { @apply text-lg font-semibold mt-6 mb-2; }
  .prose h4 { @apply text-base font-semibold mt-4 mb-1; }
  .prose p { @apply mb-4 leading-relaxed; }
  .prose ul { @apply list-disc list-outside ml-5 mb-4 space-y-1; }
  .prose ol { @apply list-decimal list-outside ml-5 mb-4 space-y-1; }
  .prose li { @apply leading-relaxed; }
  .prose a { @apply text-blue-600 dark:text-blue-400 hover:underline; }
  .prose strong { @apply font-semibold; }
  .prose em { @apply italic; }
  .prose blockquote { @apply border-l-4 border-zinc-300 dark:border-zinc-600 pl-4 italic text-zinc-600 dark:text-zinc-400 my-4; }
  .prose code { @apply bg-zinc-100 dark:bg-zinc-800 text-sm px-1.5 py-0.5 rounded font-mono; }
  .prose pre { @apply bg-zinc-100 dark:bg-zinc-800 rounded-lg p-4 overflow-x-auto mb-4; }
  .prose pre code { @apply bg-transparent p-0; }
  .prose img { @apply rounded-lg my-6 max-w-full; }
  .prose table { @apply w-full border-collapse mb-4 text-sm; }
  .prose th { @apply border border-zinc-300 dark:border-zinc-600 px-3 py-2 bg-zinc-50 dark:bg-zinc-800 font-semibold text-left; }
  .prose td { @apply border border-zinc-300 dark:border-zinc-600 px-3 py-2; }
  .prose hr { @apply border-zinc-200 dark:border-zinc-700 my-8; }

  .nav-link.is-active { @apply text-zinc-900 dark:text-white font-medium; }

  /* nav count badges */
  .nav-badge {
    display: inline-block;
    margin-left: 0.3rem;
    padding: 0.05rem 0.32rem;
    font-size: 0.62rem;
    font-weight: 700;
    line-height: 1.4;
    border-radius: 999px;
    color: rgb(99 102 241);
    background: rgba(99, 102, 241, 0.12);
    vertical-align: 1px;
    transition: background-color 0.18s ease, color 0.18s ease;
  }
  .nav-link:hover .nav-badge,
  .nav-link.is-active .nav-badge {
    color: #fff;
    background: linear-gradient(90deg, #3b82f6, #8b5cf6);
  }
  .dark .nav-badge {
    color: rgb(165 180 252);
    background: rgba(129, 140, 248, 0.18);
  }

  /* scroll-progress bar */
  #scroll-progress {
    position: absolute;
    left: 0;
    bottom: -1px;
    height: 2px;
    width: 100%;
    transform: scaleX(0);
    transform-origin: left;
    background: linear-gradient(90deg, #3b82f6, #8b5cf6, #ec4899);
    will-change: transform;
  }

  @media (prefers-reduced-motion: reduce) {
    #scroll-progress { transition: none; }
  }
</style>
